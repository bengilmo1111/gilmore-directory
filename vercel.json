{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/beryl-racing",
      "destination": "/beryl-racing/",
      "permanent": false
    },
    {
      "source": "/beryl-racing-3d",
      "destination": "/beryl-racing/",
      "permanent": true
    },
    {
      "source": "/beryl-racing-3d/",
      "destination": "/beryl-racing/",
      "permanent": true
    },
    {
      "source": "/beryl-racing-3d/:path*",
      "destination": "/beryl-racing/:path*",
      "permanent": true
    },
    {
      "source": "/old-alicetown",
      "destination": "/old-alicetown/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/beryl-racing/",
      "destination": "https://beryl-racing.vercel.app/"
    },
    {
      "source": "/beryl-racing/:path*",
      "destination": "https://beryl-racing.vercel.app/:path*"
    },
    {
      "source": "/old-alicetown/",
      "destination": "https://old-alicetown.vercel.app/"
    },
    {
      "source": "/old-alicetown/:path*",
      "destination": "https://old-alicetown.vercel.app/:path*"
    }
  ]
}
